{
  "name": "@future/dsh-browser-tool",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "description": "Silent, long-running browser runtime for DeepSeek Harness: persistent login, headless/offscreen visibility, watchdog recovery, snapshot refs, layered extraction, network capture, batch collection and multi-agent workspaces.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "browser-automation",
    "playwright",
    "mcp",
    "agent"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "lib/adapters/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/*.md",
    "skills/**"
  ],
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "scripts": {
    "test": "node test/unit.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:heal": "node test/heal.mjs",
    "verify:docs": "node test/docs.mjs",
    "bench": "node test/bench.mjs",
    "bench:forum": "node test/bench-forum.mjs pilot 100 3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  }
}
