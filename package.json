{
  "name": "@future/dsh-browser-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser operation tools for DeepSeek Harness: persistent login, snapshot refs, extraction, screenshots, network capture and batch collection.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  }
}
